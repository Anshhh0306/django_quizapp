# Settings for QuizHub. Copy ONLY the lines you need into a file called .env (never commit that file).
# Lines starting with # are switched off.

# --- Database (required): a PostgreSQL address, postgres://USER:PASSWORD@HOST:5432/DATABASE
# A password with symbols must be written percent-encoded: @ becomes %40, # becomes %23, / becomes %2F, : becomes %3A.
DATABASE_URL=postgres://postgres:YOUR_PASSWORD@localhost:5432/quizhub
# `manage.py test` uses this one instead and ignores DATABASE_URL, so tests never touch the live database.
# On your own computer it can be the same address: Django makes and removes its own test_ database.
TEST_DATABASE_URL=postgres://postgres:YOUR_PASSWORD@localhost:5432/quizhub

# --- A real server (gunicorn) needs ALL THREE of these, or the app refuses to start.
# --- Do not use them on your own computer: DJANGO_DEBUG=False would break `runserver`.
# DJANGO_SECRET_KEY=change-me-to-a-long-random-string
# DJANGO_DEBUG=False
# DJANGO_ALLOWED_HOSTS=quiz.your-college.edu

# --- Behind a host's own proxy (Zoho Catalyst and Render both need these; on Render find the count with the address panel). Set them only when ALL traffic really comes through that proxy.
# DJANGO_TRUSTED_PROXY_COUNT=1   # how many of the host's proxies are in front of the app: the visitor's address is read from the right end of X-Forwarded-For
# DJANGO_ASSUME_HTTPS=True       # the host ends HTTPS itself and passes plain requests on (its Host header even carries ":443")
# A database that does not answer is given up on after 10 seconds (per address); to change that, end DATABASE_URL with ?connect_timeout=5

# --- Email (Gmail). Without EMAIL_HOST_PASSWORD, emails are printed in the terminal instead of being sent.
# Make an "App password" for the Gmail account (Google Account > Security > App passwords) and paste it here.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your.address@gmail.com
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=QuizHub <your.address@gmail.com>
# To throw emails away (load tests): EMAIL_BACKEND=django.core.mail.backends.dummy.EmailBackend
