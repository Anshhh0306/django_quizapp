# Django Configuration
#
# On your own computer none of these are needed: `python manage.py runserver` runs in debug mode on localhost.
# On a real server (gunicorn) ALL THREE are required, or the app refuses to start:
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=quiz.your-college.edu

# Email Configuration (SRMIST Gmail SMTP)
# Set your Gmail App Password here for actual email delivery
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=srmverify@gmail.com
EMAIL_HOST_PASSWORD=your_gmail_app_password_here
DEFAULT_FROM_EMAIL=SRM Quiz Platform <srmverify@gmail.com>
